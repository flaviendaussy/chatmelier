# === Secrets — NE JAMAIS COMMITTER (dépôt origin PUBLIC) ===
# Ajouté lors du handover Antigravity → Claude (2026-09-14).
# Ces fichiers contiennent des clés d'API et des mots de passe en clair.
build_bundle.sh
setup_playstore_keystore.sh
# La console admin embarque un JWT service_role Supabase en dur.
# Retirée du suivi git ET du déploiement web ; à reconstruire avec une auth serveur.
admin_console/
# Chaînes de connexion. Celle du rôle de lecture des remontées vit normalement dans
# ~/.chatmelier/feedback.env, hors du dépôt — ces motifs sont une ceinture de sécurité
# au cas où un fichier d'environnement atterrirait ici par accident.
*.env
!.env.example
.chatmelier/
# Configuration de la page invité légère, écrite par build_and_sync_web.sh (qui recopie le
# build à la racine) : l'adresse et la clé publiable n'ont pas à être suivies une seconde fois.
table/config.js
app/web/table/config.js

# Artefacts temporaires de la CLI Supabase
supabase/.temp/
supabase/supabase/

# Assets parqués — hors bundle, conservés pour un retour éventuel (badges, scratchcard)
