<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Chatmelier</string>
	<!-- Les langues de l'app : sans elles, iOS montre ses propres écrans (photos, partage)
	     en anglais sur un téléphone français. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
		<string>es</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>chatmelier</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Chatmelier a besoin d'accéder à l'appareil photo pour scanner les étiquettes de vin.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Chatmelier a besoin d'accéder à vos photos pour importer des étiquettes de vin.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Chatmelier photographie étiquettes et cartes des vins, sans jamais enregistrer de son.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Chatmelier utilise votre position pour proposer les restaurants et bars proches de vos dégustations, et reconnaître votre cave.</string>
	<!-- Exigée par Apple (ITMS-90683, build 74) parce que geolocator contient le code de la
	     demande « toujours ». Elle ne change rien : geolocator demande « pendant l'utilisation »
	     dès que la clé ci-dessus existe, et l'app ne suit jamais la position en arrière-plan. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Chatmelier n'utilise votre position que lorsque l'app est ouverte, pour proposer les restaurants et bars proches de vos dégustations, et reconnaître votre cave. Elle ne la suit jamais en arrière-plan.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.chatmelier.chatmelier</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>chatmelier</string>
			</array>
		</dict>
	</array>
	<!-- Google Mobile Ads (AdMob) iOS App ID (Official test safeguard, replace with your production iOS App ID from AdMob console) -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- SKAdNetwork Identifiers for Google AdMob -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
